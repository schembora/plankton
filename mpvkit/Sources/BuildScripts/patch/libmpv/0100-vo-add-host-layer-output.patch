+
+/*
+ * Video output that hands VideoToolbox frames straight to an
+ * AVSampleBufferDisplayLayer supplied by the host application as --wid.
+ *
+ * The point of this over the GPU outputs on Apple platforms is that the system
+ * only composites video it owns: Picture in Picture and the lock screen's now
+ * playing surface both read from an AVSampleBufferDisplayLayer or an
+ * AVPlayerLayer, and neither can be fed from a CAMetalLayer no matter what is
+ * drawn into it. Decoded frames already are CVPixelBuffers when hwdec is
+ * videotoolbox, so this output is a handoff rather than a conversion.
+ *
+ * Presentation timing stays with mpv. Frames are enqueued for immediate
+ * display as flip_page delivers them, so mpv's own clock paces playback and
+ * the layer is never asked to schedule anything. The layer's control timebase
+ * belongs to the host, which needs it for Picture in Picture's transport UI
+ * and knows the playback state this output does not.
+ *
+ * Geometry belongs to the host too. The layer is positioned and sized by the
+ * UI framework and scales its contents according to videoGravity, so this
+ * output never sets a drawable size, and rotating the device is not something
+ * it has to notice.
+ */
+
+#include <AVFoundation/AVFoundation.h>
+#include <CoreMedia/CoreMedia.h>
+
+#include "common/common.h"
+#include "video/mp_image.h"
+#include "vo.h"
+
+struct priv {
+    AVSampleBufferDisplayLayer *layer;
+
+    // Held between draw_frame and flip_page, which is where mpv wants the
+    // frame actually shown.
+    struct mp_image *next_image;
+
+    // Describes the pixel buffers being enqueued. Cached rather than built per
+    // frame, since it only changes when the format or the size does.
+    CMVideoFormatDescriptionRef format;
+};
+
+static void release_format(struct priv *p)
+{
+    if (p->format) {
+        CFRelease(p->format);
+        p->format = NULL;
+    }
+}
+
+/// The layer stops accepting frames after a failure, and the only way back is
+/// to flush it. Without this a single transient error ends playback with the
+/// picture frozen and audio still running.
+static bool recover_if_failed(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (p->layer.status != AVQueuedSampleBufferRenderingStatusFailed)
+        return true;
+
+    MP_WARN(vo, "display layer failed: %s\n",
+            p->layer.error.localizedDescription.UTF8String ?: "unknown");
+    [p->layer flush];
+    release_format(p);
+
+    return p->layer.status != AVQueuedSampleBufferRenderingStatusFailed;
+}
+
+/// Wraps a decoded frame for the layer. The pixel buffer is retained by the
+/// sample buffer, so the image can be released as soon as this returns.
+static CMSampleBufferRef wrap_pixel_buffer(struct vo *vo, CVPixelBufferRef pixbuf)
+{
+    struct priv *p = vo->priv;
+
+    // A stream can change resolution mid-playback, and the cached description
+    // would then describe the previous size.
+    if (p->format && !CMVideoFormatDescriptionMatchesImageBuffer(p->format, pixbuf))
+        release_format(p);
+
+    if (!p->format) {
+        OSStatus status = CMVideoFormatDescriptionCreateForImageBuffer(
+            kCFAllocatorDefault, pixbuf, &p->format);
+        if (status != noErr) {
+            MP_ERR(vo, "could not describe frame: %d\n", (int)status);
+            return NULL;
+        }
+    }
+
+    // Invalid timing throughout: the sample carries no schedule because mpv
+    // has already decided this frame is due now. Giving the layer timestamps
+    // as well would have it pace against its own timebase and fight the clock
+    // that just released the frame.
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+
+    CMSampleBufferRef sample = NULL;
+    OSStatus status = CMSampleBufferCreateReadyWithImageBuffer(
+        kCFAllocatorDefault, pixbuf, p->format, &timing, &sample);
+    if (status != noErr) {
+        MP_ERR(vo, "could not wrap frame: %d\n", (int)status);
+        return NULL;
+    }
+
+    return sample;
+}
+
+/// Says "show this now" rather than scheduling it, which is what makes mpv the
+/// clock. The attachment is on the sample rather than the layer because it
+/// describes this frame, not the stream.
+static void mark_display_immediately(CMSampleBufferRef sample)
+{
+    CFArrayRef attachments =
+        CMSampleBufferGetSampleAttachmentsArray(sample, true);
+    if (!attachments || CFArrayGetCount(attachments) == 0)
+        return;
+
+    CFMutableDictionaryRef entry =
+        (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+    CFDictionarySetValue(entry, kCMSampleAttachmentKey_DisplayImmediately,
+                         kCFBooleanTrue);
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    int64_t wid = vo->opts->WinID;
+    if (wid == 0 || wid == -1) {
+        MP_FATAL(vo, "no --wid given; this output draws into a layer owned by "
+                     "the host application\n");
+        return -1;
+    }
+
+    // mpv is built without ARC, so this is a plain cast and the reference is
+    // ours to manage.
+    id object = (id)(intptr_t)wid;
+    if (![object isKindOfClass:[AVSampleBufferDisplayLayer class]]) {
+        MP_FATAL(vo, "--wid is not an AVSampleBufferDisplayLayer\n");
+        return -1;
+    }
+
+    // Retained even though the host is expected to outlive us. It costs
+    // nothing, and the alternative is a dangling layer if the host ever tears
+    // its view down while the player is still shutting off.
+    p->layer = [(AVSampleBufferDisplayLayer *)object retain];
+
+    return 0;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    // Hardware frames only. Anything else would have to be uploaded into a
+    // CVPixelBuffer first, and the whole reason this output exists is that
+    // VideoToolbox has already produced one.
+    return format == IMGFMT_VIDEOTOOLBOX;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    struct priv *p = vo->priv;
+
+    // The new stream's frames describe themselves, and the cached description
+    // is from the last one.
+    release_format(p);
+
+    @autoreleasepool {
+        [p->layer flush];
+    }
+
+    return 0;
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+
+    struct mp_image *image = NULL;
+    // A repeat or a redraw is the same picture the layer is already showing.
+    if (!frame->redraw && !frame->repeat && frame->current)
+        image = mp_image_new_ref(frame->current);
+
+    talloc_free(p->next_image);
+    p->next_image = image;
+
+    return VO_TRUE;
+}
+
+static void flip_page(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->next_image)
+        return;
+
+    @autoreleasepool {
+        CVPixelBufferRef pixbuf = (CVPixelBufferRef)p->next_image->planes[3];
+
+        if (pixbuf && recover_if_failed(vo) && p->layer.readyForMoreMediaData) {
+            CMSampleBufferRef sample = wrap_pixel_buffer(vo, pixbuf);
+            if (sample) {
+                mark_display_immediately(sample);
+                [p->layer enqueueSampleBuffer:sample];
+                CFRelease(sample);
+            }
+        }
+
+        // Dropped rather than held when the layer is busy. Queueing behind it
+        // would show this frame late, and mpv has already moved on.
+        mp_image_unrefp(&p->next_image);
+    }
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    struct priv *p = vo->priv;
+
+    switch (request) {
+    case VOCTRL_RESET:
+        // Seeking and stopping both land here. Whatever is queued belongs to
+        // the position being left behind.
+        @autoreleasepool {
+            [p->layer flush];
+        }
+        return VO_TRUE;
+    }
+
+    return VO_NOTIMPL;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    @autoreleasepool {
+        // Leaves the layer empty for whoever gets it next: the host keeps it
+        // across playthroughs, and a stale last frame would show under the
+        // start of the following one.
+        [p->layer flushAndRemoveImage];
+    }
+
+    mp_image_unrefp(&p->next_image);
+    release_format(p);
+
+    [p->layer release];
+    p->layer = NULL;
+}
+
+const struct vo_driver video_out_avfoundation = {
+    .description = "AVSampleBufferDisplayLayer (host supplied)",
+    .name = "avfoundation",
+    // The layer takes ownership of what it is given, so mpv must not assume a
+    // frame stays valid after it has been handed over.
+    .caps = VO_CAP_NORETAIN,
+    .preinit = preinit,
+    .query_format = query_format,
+    .reconfig = reconfig,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+};
