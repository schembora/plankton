+/// Points an mp_image at a locked CVPixelBuffer. No copy and no ownership:
+/// the image is a view, valid only while the buffer stays locked.
+static void image_from_pixel_buffer(struct mp_image *img, CVPixelBufferRef buf,
+                                    int imgfmt, struct mp_image_params *params)
+{
+    *img = (struct mp_image){0};
+
+    // Colour first, then format and size. mp_image_setfmt writes
+    // params.imgfmt as well as imgfmt, so copying the stream's params over the
+    // top afterwards puts the frame's own format back — the hardware one for a
+    // buffer that came from the decoder. The image then claims to be NV12 in
+    // one field and VideoToolbox in another, and osd_draw_on_image reads the
+    // one that is wrong and refuses to draw.
+    img->params = *params;
+    mp_image_setfmt(img, imgfmt);
+    mp_image_set_size(img, (int)CVPixelBufferGetWidth(buf), (int)CVPixelBufferGetHeight(buf));
+
+    size_t planes = CVPixelBufferGetPlaneCount(buf);
+    for (size_t i = 0; i < planes && i < MP_MAX_PLANES; i++) {
+        img->planes[i] = CVPixelBufferGetBaseAddressOfPlane(buf, i);
+        img->stride[i] = CVPixelBufferGetBytesPerRowOfPlane(buf, i);
+    }
+}
+
+/// The mpv format matching a CoreVideo one, for describing a buffer we are
+/// about to draw into.
+static int imgfmt_for_cv(OSType fmt)
+{
+    switch (fmt) {
+    case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        return IMGFMT_NV12;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        return IMGFMT_P010;
+    default:
+        return 0;
+    }
+}
+
+static void probe_osd(void *ctx, struct sub_bitmaps *imgs)
+{
+    *(bool *)ctx = true;
+}
+
+/// Whether anything would be drawn for this frame.
+///
+/// Asked before compositing so the common case stays a handoff: a hardware
+/// frame with no subtitles on screen goes straight to the layer, and only one
+/// that has something to draw pays for a copy. mpv caches the rendered
+/// bitmaps, so asking and then drawing does not rasterise twice.
+static bool has_osd(struct vo *vo, struct mp_osd_res res, double pts)
+{
+    bool any = false;
+    osd_draw(vo->osd, res, pts, 0, mp_draw_sub_formats, probe_osd, &any);
+    return any;
+}
+/// Duplicates a decoder owned frame so it can be drawn on. Only reached when
+/// there is OSD for this frame.
+static CVPixelBufferRef copy_for_compositing(struct vo *vo, CVPixelBufferRef src)
+{
+    struct priv *p = vo->priv;
+
+    OSType fmt = CVPixelBufferGetPixelFormatType(src);
+    int w = (int)CVPixelBufferGetWidth(src);
+    int h = (int)CVPixelBufferGetHeight(src);
+    if (!ensure_pool(vo, w, h, fmt))
+        return NULL;
+
+    CVPixelBufferRef dst = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, p->pool, &dst) != kCVReturnSuccess)
+        return NULL;
+
+    if (CVPixelBufferLockBaseAddress(src, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) {
+        CVPixelBufferRelease(dst);
+        return NULL;
+    }
+    if (CVPixelBufferLockBaseAddress(dst, 0) != kCVReturnSuccess) {
+        CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+        CVPixelBufferRelease(dst);
+        return NULL;
+    }
+
+    size_t planes = CVPixelBufferGetPlaneCount(dst);
+    for (size_t i = 0; i < planes; i++) {
+        uint8_t *to = CVPixelBufferGetBaseAddressOfPlane(dst, i);
+        const uint8_t *from = CVPixelBufferGetBaseAddressOfPlane(src, i);
+        size_t to_stride = CVPixelBufferGetBytesPerRowOfPlane(dst, i);
+        size_t from_stride = CVPixelBufferGetBytesPerRowOfPlane(src, i);
+        size_t rows = MPMIN(CVPixelBufferGetHeightOfPlane(dst, i),
+                            CVPixelBufferGetHeightOfPlane(src, i));
+        size_t copy = MPMIN(to_stride, from_stride);
+        if (!to || !from)
+            continue;
+
+        for (size_t y = 0; y < rows; y++)
+            memcpy(to + y * to_stride, from + y * from_stride, copy);
+    }
+
+    CVPixelBufferUnlockBaseAddress(dst, 0);
+    CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+
+    // The copy inherits nothing, so the colour tags have to be restored or the
+    // layer would render a correctly decoded frame with the wrong matrix.
+    CVBufferPropagateAttachments(src, dst);
+
+    return dst;
+}
+
+/// Draws mpv's OSD into a buffer we own.
+static void composite_osd(struct vo *vo, CVPixelBufferRef buf, struct mp_osd_res res, double pts)
+{
+    struct priv *p = vo->priv;
+
+    int imgfmt = imgfmt_for_cv(CVPixelBufferGetPixelFormatType(buf));
+    if (!imgfmt)
+        return;
+
+    if (CVPixelBufferLockBaseAddress(buf, 0) != kCVReturnSuccess)
+        return;
+
+    struct mp_image img;
+    image_from_pixel_buffer(&img, buf, imgfmt, &p->params);
+    osd_draw_on_image(vo->osd, res, pts, 0, &img);
+
+    CVPixelBufferUnlockBaseAddress(buf, 0);
+}
+
