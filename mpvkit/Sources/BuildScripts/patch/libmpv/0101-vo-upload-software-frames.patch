+/// The layer reads colour from the buffer's attachments. Only the three
+/// systems in real use are mapped; anything else is left for the layer to
+/// guess, which is what it would do anyway.
+static void tag_colour(CVPixelBufferRef buf, struct mp_image_params *params)
+{
+    CFStringRef matrix = NULL, primaries = NULL, transfer = NULL;
+
+    switch (params->repr.sys) {
+    case PL_COLOR_SYSTEM_BT_601:
+        matrix = kCVImageBufferYCbCrMatrix_ITU_R_601_4;
+        primaries = kCVImageBufferColorPrimaries_SMPTE_C;
+        break;
+    case PL_COLOR_SYSTEM_BT_2020_NC:
+    case PL_COLOR_SYSTEM_BT_2020_C:
+        matrix = kCVImageBufferYCbCrMatrix_ITU_R_2020;
+        primaries = kCVImageBufferColorPrimaries_ITU_R_2020;
+        break;
+    default:
+        matrix = kCVImageBufferYCbCrMatrix_ITU_R_709_2;
+        primaries = kCVImageBufferColorPrimaries_ITU_R_709_2;
+        break;
+    }
+
+    switch (params->color.transfer) {
+    case PL_COLOR_TRC_PQ:
+        transfer = kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ;
+        break;
+    case PL_COLOR_TRC_HLG:
+        transfer = kCVImageBufferTransferFunction_ITU_R_2100_HLG;
+        break;
+    default:
+        transfer = kCVImageBufferTransferFunction_ITU_R_709_2;
+        break;
+    }
+
+    CVBufferSetAttachment(buf, kCVImageBufferYCbCrMatrixKey, matrix,
+                          kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(buf, kCVImageBufferColorPrimariesKey, primaries,
+                          kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(buf, kCVImageBufferTransferFunctionKey, transfer,
+                          kCVAttachmentMode_ShouldPropagate);
+}
+
+/// The CoreVideo format for the two layouts this output accepts.
+static OSType cv_format_for(int imgfmt)
+{
+    switch (imgfmt) {
+    case IMGFMT_NV12:
+        return kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    case IMGFMT_P010:
+        return kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+    default:
+        return 0;
+    }
+}
+
+static void release_pool(struct priv *p)
+{
+    if (p->pool) {
+        CVPixelBufferPoolRelease(p->pool);
+        p->pool = NULL;
+    }
+}
+
+/// Buffers must be IOSurface backed or the layer cannot display them, which
+/// fails silently rather than loudly: frames are accepted and nothing appears.
+static bool ensure_pool(struct vo *vo, int w, int h, OSType fmt)
+{
+    struct priv *p = vo->priv;
+
+    if (p->pool && p->pool_w == w && p->pool_h == h && p->pool_fmt == fmt)
+        return true;
+
+    release_pool(p);
+
+    CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(
+        kCFAllocatorDefault, 4, &kCFTypeDictionaryKeyCallBacks,
+        &kCFTypeDictionaryValueCallBacks);
+    if (!attrs)
+        return false;
+
+    CFNumberRef fmt_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &fmt);
+    CFNumberRef w_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &w);
+    CFNumberRef h_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &h);
+    CFDictionaryRef iosurface = CFDictionaryCreate(
+        kCFAllocatorDefault, NULL, NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+        &kCFTypeDictionaryValueCallBacks);
+
+    CFDictionarySetValue(attrs, kCVPixelBufferPixelFormatTypeKey, fmt_num);
+    CFDictionarySetValue(attrs, kCVPixelBufferWidthKey, w_num);
+    CFDictionarySetValue(attrs, kCVPixelBufferHeightKey, h_num);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, iosurface);
+
+    OSStatus status = CVPixelBufferPoolCreate(kCFAllocatorDefault, NULL, attrs, &p->pool);
+
+    CFRelease(fmt_num);
+    CFRelease(w_num);
+    CFRelease(h_num);
+    CFRelease(iosurface);
+    CFRelease(attrs);
+
+    if (status != kCVReturnSuccess) {
+        MP_ERR(vo, "could not create buffer pool: %d\n", (int)status);
+        p->pool = NULL;
+        return false;
+    }
+
+    p->pool_w = w;
+    p->pool_h = h;
+    p->pool_fmt = fmt;
+    return true;
+}
+
+/// Copies a software frame into a pooled buffer. Row by row, because mpv's
+/// stride and CoreVideo's are decided independently and rarely agree.
+static CVPixelBufferRef upload_image(struct vo *vo, struct mp_image *mpi)
+{
+    struct priv *p = vo->priv;
+
+    OSType fmt = cv_format_for(mpi->imgfmt);
+    if (!fmt || !ensure_pool(vo, mpi->w, mpi->h, fmt))
+        return NULL;
+
+    CVPixelBufferRef buf = NULL;
+    if (CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, p->pool, &buf) != kCVReturnSuccess)
+        return NULL;
+
+    if (CVPixelBufferLockBaseAddress(buf, 0) != kCVReturnSuccess) {
+        CVPixelBufferRelease(buf);
+        return NULL;
+    }
+
+    size_t planes = CVPixelBufferGetPlaneCount(buf);
+    for (size_t i = 0; i < planes && i < MP_MAX_PLANES; i++) {
+        uint8_t *dst = CVPixelBufferGetBaseAddressOfPlane(buf, i);
+        size_t dst_stride = CVPixelBufferGetBytesPerRowOfPlane(buf, i);
+        size_t rows = CVPixelBufferGetHeightOfPlane(buf, i);
+        if (!dst || !mpi->planes[i])
+            continue;
+
+        size_t src_stride = mpi->stride[i] < 0 ? 0 : (size_t)mpi->stride[i];
+        size_t copy = MPMIN(src_stride, dst_stride);
+
+        for (size_t y = 0; y < rows; y++)
+            memcpy(dst + y * dst_stride, mpi->planes[i] + y * src_stride, copy);
+    }
+
+    CVPixelBufferUnlockBaseAddress(buf, 0);
+    tag_colour(buf, &p->params);
+
+    return buf;
+}
